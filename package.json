{
  "name": "site-oksana",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @oksana/web dev",
    "db:up": "docker compose --env-file apps/web/.env.development.local -f compose.dev.yaml up -d --wait postgres && pnpm db:migrate",
    "db:migrate": "docker compose --env-file apps/web/.env.development.local -f compose.dev.yaml run --rm migrate",
    "db:down": "docker compose --env-file apps/web/.env.development.local -f compose.dev.yaml down",
    "build": "pnpm --filter @oksana/web build",
    "start": "pnpm --filter @oksana/web start",
    "typecheck": "pnpm --filter @oksana/web typecheck",
    "lint": "pnpm --filter @oksana/web lint",
    "test": "pnpm --filter @oksana/web test",
    "test:e2e": "pnpm --filter @oksana/web test:e2e",
    "format": "pnpm --filter @oksana/web format",
    "format:check": "pnpm --filter @oksana/web format:check"
  }
}
