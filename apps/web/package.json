{
  "name": "@oksana/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build && node scripts/copy-static.mjs",
    "start": "node .next/standalone/apps/web/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@oksana/catalog": "workspace:*",
    "clsx": "^2.1.1",
    "next": "16.4.5",
    "nodemailer": "7.0.2",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-directive": "^4.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
