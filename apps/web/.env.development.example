# Только для локальной разработки. Скопируйте в .env.development.local.
POSTGRES_DB=oksana_dev
POSTGRES_PASSWORD=oksana_local_admin
APP_DB_PASSWORD=oksana_local_app

PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=$POSTGRES_DB
PGUSER=oksana_app
PGPASSWORD=$APP_DB_PASSWORD

# Форма сохраняет заявки в PostgreSQL без отправки писем.
LEAD_EMAIL_ENABLED=false
