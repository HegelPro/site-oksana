# Настройки серверного Compose. Для HTTPS укажите ваш домен.
SITE_ADDRESS=:80

# PostgreSQL. Пароли задайте до первого запуска; не добавляйте .env в Git.
POSTGRES_DB=oksana
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Почтовый сервер для уведомлений о заявках
LEAD_EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
LEAD_TO=
